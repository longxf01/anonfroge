APP_NAME=Anon Forge
APP_DESCRIPTION=Anon Forge
APP_ENV=development
HOST=127.0.0.1
PORT=8088
API_PREFIX=/api
OSS_ROOT=./data/oss

DB_ENGINE=postgresql
DB_DRIVER=psycopg
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=anonforge
DB_USER=anonforge
DB_PASSWORD=anonforge
TZ=Asia/Shanghai

POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_CONTAINER_NAME=anonforge_dev_postgres
DB_PORT=5432

DB_DATA_PATH=./postgres/data
DB_HEALTHCHECK_INTERVAL=10s
DB_HEALTHCHECK_TIMEOUT=5s
DB_HEALTHCHECK_RETRIES=3

USER_DEFAULT_ADMIN_NAME=admin
USER_DEFAULT_ADMIN_PASSWORD=admin123

REDIS_IMAGE=redis:8.6.3-alpine
REDIS_CONTAINER_NAME=anonforge_dev_redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATA_PATH=./redis/data
REDIS_HEALTHCHECK_INTERVAL=10s
REDIS_HEALTHCHECK_TIMEOUT=5s
REDIS_HEALTHCHECK_RETRIES=3

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=900
REFRESH_TOKEN_EXPIRE_SECONDS=604800
SECRET_KEY=179e0c5e-96e4-482f-8bda-7f94e64de29d

VISUAL_STYLE_ROOT=./data/skills/art_list
DIRECTOR_MANUAL_ROOT=./data/skills/director_manual
