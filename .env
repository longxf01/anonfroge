APP_NAME=Anon Forge
APP_DESCRIPTION=Anon Forge
APP_ENV=development
HOST=127.0.0.1
PORT=8088
API_PREFIX=/api
OSS_ROOT=./data/oss

DB_ENGINE=postgresql
DB_DRIVER=psycopg
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=anonforge
DB_USER=anonforge
DB_PASSWORD=anonforge
TZ=Asia/Shanghai

POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_CONTAINER_NAME=anonforge_dev_postgres
POSTGRES_HOST_PORT=5432

DB_DATA_PATH=./postgres/data
DB_SQLITE_PATH=./data/app.db
DB_HEALTHCHECK_INTERVAL=10s
DB_HEALTHCHECK_TIMEOUT=5s
DB_HEALTHCHECK_RETRIES=3

REDIS_IMAGE=redis:8.6.3-alpine
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_CONTAINER_NAME=anonforge_dev_redis
REDIS_DATA_PATH=./redis/data
REDIS_HEALTHCHECK_INTERVAL=10s
REDIS_HEALTHCHECK_TIMEOUT=5s
REDIS_HEALTHCHECK_RETRIES=3
REDIS_TOKEN_KEY_PREFIX=auth:token:
REDIS_TASK_STREAM_NAME=task:stream
REDIS_TASK_CONSUMER_GROUP=task-workers
REDIS_TASK_STREAM_MAX_LEN=10000
ASYNC_TASK_MODULES=app.tasks.demo
ASYNC_TASK_WORKER_CONSUMER_NAME=
ASYNC_TASK_WORKER_BATCH_SIZE=4
ASYNC_TASK_WORKER_BLOCK_MS=5000
ASYNC_TASK_WORKER_IDLE_SLEEP_SECONDS=0.5
ASYNC_TASK_WORKER_MAX_CONCURRENCY=4
ASYNC_TASK_WORKER_TASK_TIMEOUT_SECONDS=3600
ASYNC_TASK_WORKER_LOG_ENABLED=true
ASYNC_TASK_WORKER_HEARTBEAT_INTERVAL_SECONDS=30
ASYNC_TASK_WORKER_MAX_RETRIES=3
ASYNC_TASK_WORKER_RETRY_BACKOFF_SECONDS=30
ASYNC_TASK_WORKER_SHUTDOWN_TIMEOUT_SECONDS=30
ASYNC_TASK_STALE_RUNNING_TIMEOUT_SECONDS=600

USER_DEFAULT_ADMIN_NAME=admin
USER_DEFAULT_ADMIN_PASSWORD=admin123

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=300
REFRESH_TOKEN_EXPIRE_SECONDS=604800
SECRET_KEY=replace-with-a-long-random-secret

VISUAL_STYLE_ROOT=./data/skills/art_list
DIRECTOR_MANUAL_ROOT=./data/skills/director_manual
SKILLS_ROOT=./data/skills
CHAPTER_EVENT_EXTRACTION_PROMPT_NAME=chapter_event_extraction
MODEL_REQUEST_TIMEOUT_SECONDS=180
MEDIA_GENERATION_TIMEOUT_SECONDS=1800
IMAGE_GENERATION_TIMEOUT_SECONDS=600
VIDEO_GENERATION_TIMEOUT_SECONDS=3600
MEDIA_GENERATION_POLL_INTERVAL_SECONDS=5
MEDIA_GENERATION_MAX_CONCURRENCY=2
PROVIDER_TEMPLATE_PATH=./data/provider_template.py
